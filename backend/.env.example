APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=qr_user
DB_PASSWORD=qr_password
DB_NAME=qr_generator
# Optional Aiven MySQL URI. When set, this takes precedence over DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=
# Absolute or backend-relative path to Aiven's CA certificate PEM file.
DB_SSL_CA=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=720

FREE_MAX_QR_CODES=10
ADMIN_EMAIL=admin@qr.local
ADMIN_PASSWORD=Admin@123456

SEPAY_ENABLED=true
SEPAY_TRANSACTION_PREFIX=QRPRO
SEPAY_RETURN_URL=http://localhost:3000/pricing
SEPAY_WEBHOOK_SECRET=
SEPAY_API_URL=https://my.sepay.vn/userapi/transactions/list
SEPAY_API_KEY=
BANK_CODE=
ACCOUNT_NO=
ACCOUNT_NAME=
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=qr-generator/logos
CLOUDINARY_MAX_UPLOAD_BYTES=5242880
